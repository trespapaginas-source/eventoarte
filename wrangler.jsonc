{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eventoarte",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,

  // ====== Bindings (recursos de Cloudflare) ======
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eventoarte-db",
      "database_id": "337383f0-fbf2-4101-af7c-1083f691ca4f",
      "migrations_dir": "./drizzle/migrations"
    }
  ],

  // R2 se activa desde el dashboard de Cloudflare (un clic) y luego se
  // descomenta este bloque para habilitar la subida de imágenes en el CMS:
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "eventoarte-media" }
  // ],

  // ====== Variables públicas (no sensibles) ======
  "vars": {
    "WA_NUMBER": "573000000000",
    "PUBLIC_URL": "https://eventoarte.co",
    "SITE_NAME": "eventoarte.co"
  }
}
