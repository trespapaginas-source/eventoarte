{
  "name": "eventoarte",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "eventoarte.co — Catálogo de recordatorios y productos personalizados para eventos",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply eventoarte-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply eventoarte-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "wrangler d1 execute eventoarte-db --local --file=./app/lib/db/seed.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@react-router/dev": "^7.1.0",
    "@react-router/node": "^8.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.28.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "wrangler": "^4.118.0"
  }
}
