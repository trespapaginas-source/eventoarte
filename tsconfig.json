{
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "workers/**/*.ts",
    ".react-router/types/**/*",
    "worker-configuration.d.ts"
  ],
  "exclude": ["vite.config.ts", "drizzle.config.ts", "react-router.config.ts"],
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    },
    "rootDirs": [".", "./.react-router/types"],
    "types": ["@react-router/node", "@cloudflare/workers-types", "vite/client", "node"]
  }
}
